#!/bin/sh

DIR="$HOME/Documents/Screenshots"

case "$1" in
  color)
    nix-shell -p hyprpicker wl-clipboard --run '
      sleep 0.2
      hyprpicker | wl-copy
    '
    ;;
  area)
    nix-shell -p grim slurp wl-clipboard --run '
      DIR="$HOME/Documents/Screenshots"
      mkdir -p "$DIR"
      file="$DIR/$(date +%Y%m%d_%H%M%S%N).png"
      geom=$(slurp) || exit 1
      [ -n "$geom" ] || exit 0
      grim -g "$geom" "$file" && wl-copy < "$file"
    '
    ;;
  full)
    nix-shell -p grim wl-clipboard --run '
      DIR="$HOME/Documents/Screenshots"
      mkdir -p "$DIR"
      file="$DIR/$(date +%Y%m%d_%H%M%S%N).png"
      sleep 0.5
      grim - | tee "$file" | wl-copy
    '
    ;;
  *)
    exit 1
    ;;
esac
