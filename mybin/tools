#!/usr/bin/env nix-shell
#! nix-shell -i sh -p grim slurp wl-clipboard hyprpicker

DIR="$HOME/Documents/Screenshots"

case "$1" in
  color)
    sleep 0.2
    hyprpicker | wl-copy
    ;;
  area)
    mkdir -p "$DIR"
    file="$DIR/$(date +%Y%m%d_%H%M%S).png"
    geom=$(slurp) || exit 1
    [ -n "$geom" ] || exit 0
    grim -g "$geom" "$file" && wl-copy < "$file"
    ;;
  full)
    mkdir -p "$DIR"
    file="$DIR/$(date +%Y%m%d_%H%M%S).png"
    sleep 0.5
    grim - | tee "$file" | wl-copy
    ;;
  *)
    exit 1
    ;;
esac