#!/usr/bin/env bash

set -euo pipefail

# PKILL
procs=(fcitx5 hyprpaper hypridle)

for p in "${procs[@]}"; do
    pkill -x "$p" 2>/dev/null || true
done

for p in "${procs[@]}"; do
    while pgrep -x "$p" >/dev/null; do
        sleep 0.05
    done
done

# EXEC
fcitx5 -d &

systemctl --user start nix-wallpaper.service || true
hyprpaper &
hypridle &

exit 0
